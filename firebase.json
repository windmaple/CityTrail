{
  "auth": {
    "providers": {
      "emailPassword": false,
      "googleSignIn": {
        "oAuthBrandDisplayName": "CityTrail",
        "supportEmail": "windmaple@gmail.com",
        "authorizedRedirectUris": [
          "https://citytrail-10092006.firebaseapp.com/__/auth/handler",
          "http://localhost"
        ]
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "edition": "enterprise",
    "database": "citytrail",
    "location": "asia-east1"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  }
}
